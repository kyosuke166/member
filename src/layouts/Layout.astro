---
import '../styles/global.css';

interface Props {
  title?: string;
  isLoggedIn?: boolean;
}

const { title = "SBTフリーランス", isLoggedIn = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">
    
    <nav class="bg-white border-b border-slate-200 px-6 py-4 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <a href={isLoggedIn ? "/dashboard" : "/"} class="flex items-center gap-2 no-underline group">
          <div class="w-8 h-8 rounded-lg overflow-hidden shadow-sm group-hover:shadow transition-shadow">
            <img src="/apple-touch-icon.png" alt="SBT Logo" class="w-full h-full object-cover" />
          </div>
          <div class="font-black text-slate-800 text-xl tracking-tighter italic group-hover:text-blue-600 transition-colors">
            SBTフリーランス
          </div>
        </a>
        
        <div class="flex items-center gap-4 md:gap-6">
          {isLoggedIn ? (
            <>
              <div class="hidden md:flex items-center gap-2">
                <a href="/profile" class="no-underline flex items-center gap-2 group">
                  <span id="header-user-name" class="text-sm font-bold text-slate-600 group-hover:text-blue-600 transition-colors">読み込み中...</span>
                  <span id="header-last-login" class="text-[13px] text-slate-400 font-medium">
                    </span>
                </a>
              </div>

              <div class="h-4 w-px bg-slate-200 hidden md:block"></div>

              <a href="/profile" class="group p-1 rounded-lg hover:bg-slate-50 transition-all no-underline flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-300 group-hover:text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                </svg>
              </a>

              <a href="/api/logout.php" class="text-xs font-bold text-slate-400 hover:text-red-500 transition-colors py-2 no-underline">ログアウト</a>
            </>
          ) : (
            <a href="https://sbt-inc.co.jp/contact" class="text-xs font-bold text-blue-600 hover:text-blue-700 py-2 no-underline">
              お問い合わせ
            </a>
          )}
        </div>
      </div>
    </nav>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-white border-t border-slate-200 py-8">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <p class="text-xs text-slate-400 tracking-widest font-medium uppercase">
          © 2015 SBT-INC. ALL RIGHTS RESERVED.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .no-underline { text-decoration: none; }
  input::placeholder, textarea::placeholder { color: #cccccc; }
</style>