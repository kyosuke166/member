---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ダッシュボード | SBTフリーランス" isLoggedIn={true}>
  <main id="dashboard-content" class="invisible opacity-0 transition-opacity duration-300">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4 border-b border-slate-200 pb-8">
        <div>
          <h1 class="text-3xl font-black text-slate-900 tracking-tight">ダッシュボード</h1>
          <p id="user-status-label" class="text-slate-50 text-[10px] mt-3 inline-block bg-slate-800 px-3 py-1 rounded-full font-bold uppercase tracking-wider transition-colors duration-500">
            Status: 読込中...
          </p>
        </div>
        <div class="flex gap-2">
          <a href="/profile" class="bg-white border border-slate-200 text-slate-700 px-5 py-2.5 rounded-xl text-xs font-bold hover:bg-slate-50 transition-all shadow-sm text-decoration-none">プロフィール設定</a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition-shadow">
          <p class="text-slate-400 text-[10px] font-bold mb-1 uppercase tracking-widest">マッチング度</p>
          <div class="flex items-end gap-2"><span class="text-3xl font-black text-blue-600">85</span><span class="text-sm font-bold text-slate-400 mb-1">%</span></div>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <p class="text-slate-400 text-[10px] font-bold mb-1 uppercase tracking-widest">掲載中の最新案件</p>
          <p class="text-3xl font-black text-slate-800" id="project-count">-- <span class="text-xs text-slate-400">件</span></p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <p class="text-slate-400 text-[10px] font-bold mb-1 uppercase tracking-widest">次回更新日時</p>
          <p class="text-xl font-black text-slate-800" id="next-update-display">----/--/-- --:--</p>
        </div>
      </div>

      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-xl font-black text-slate-800 flex items-center gap-2">
          <span class="w-2 h-6 bg-blue-600 rounded-full"></span>
          あなたにマッチする新着案件
        </h2>
        <div class="flex gap-2">
        </div>
      </div>

      <div id="project-list-container" class="grid grid-cols-1 gap-8">
        <p class="text-center py-20 text-slate-400 font-bold italic tracking-widest">CATALOG LOADING...</p>
      </div>
    </div>
  </main>

  <script is:inline>
    let allProjects = [];

    // --- 次回更新日時を計算・表示する関数 ---
    function updateNextScheduleDisplay() {
      const display = document.getElementById('next-update-display');
      if (!display) return;

      const now = new Date();
      // 次の「00分」を計算（現在の時に +1 する）
      const nextUpdate = new Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours() + 1, 0, 0);

      const y = nextUpdate.getFullYear();
      const m = String(nextUpdate.getMonth() + 1).padStart(2, '0');
      const d = String(nextUpdate.getDate()).padStart(2, '0');
      
      const hour24 = nextUpdate.getHours();
      // AM/PMの判定
      const period = hour24 < 12 ? 'AM' : 'PM';
      // 時刻の0埋めなし（hour24をそのまま使用）
      const hh = hour24;
      // 分は0埋めあり
      const mm = String(nextUpdate.getMinutes()).padStart(2, '0');

      display.textContent = `${y}/${m}/${d} ${period} ${hh}:${mm}`;
    }

    // 1分ごとにチェック
    setInterval(updateNextScheduleDisplay, 60000);
    // --------------------------------------

    function renderProjects(projects) {
      const container = document.getElementById('project-list-container');
      const countDisplay = document.getElementById('project-count');
      
      if (countDisplay) countDisplay.innerHTML = `${projects.length} <span class="text-xs text-slate-400">件</span>`;
      if (!container) return;

      if (!projects || projects.length === 0) {
        container.innerHTML = '<p class="text-center py-20 text-slate-500 font-bold">現在、掲載できる案件がありません。</p>';
        return;
      }

      container.innerHTML = projects.map(p => {
        const displayPrice = p.reward ? `~${p.reward}万` : '応相談';
        const skillArray = Array.isArray(p.skills) ? p.skills : [];

        return `
        <div class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center">
              <span class="inline-block bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded-md uppercase tracking-wider">
                NEW
              </span>
              <span class="ml-3 text-[10px] text-slate-400 font-bold">
                掲載: ${p.created ? p.created.split(' ')[0].replace(/-/g, '/') : ''}
              </span>
            </div>
          </div>

          <h3 class="text-xl font-extrabold text-slate-900 mb-6 leading-snug group-hover:text-blue-600 transition-colors">
            ${p.title}
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-slate-100 rounded-xl overflow-hidden mb-6 shadow-sm">
            <div class="bg-slate-50/50 p-4 border-b md:border-b-0 md:border-r border-slate-100">
              <p class="text-[9px] font-bold text-slate-400 mb-1 tracking-widest uppercase">作業期間</p>
              <p class="text-[13px] font-bold text-slate-700">${p.term || '相談'}</p>
            </div>
            
            <div class="bg-slate-50/50 p-4 border-b md:border-b-0 md:border-r border-slate-100">
              <p class="text-[9px] font-bold text-slate-400 mb-1 tracking-widest uppercase">主要拠点</p>
              <div class="flex flex-col gap-2">
                <p class="text-[13px] font-bold text-slate-700 leading-snug">${p.location || '都内'}</p>
                ${p.remote ? `
                  <div>
                    <span class="inline-block text-[9px] bg-white text-blue-600 px-2 py-0.5 rounded border border-blue-200 font-bold">
                      ${p.remote}
                    </span>
                  </div>
                ` : ''}
              </div>
            </div>

            <div class="bg-slate-50/50 p-4">
              <p class="text-[9px] font-bold text-slate-400 mb-1 tracking-widest uppercase">単価(目安)</p>
              <p class="text-lg font-black text-blue-600 tracking-tight">${displayPrice}</p>
            </div>
          </div>

          <div class="mb-8">
            <p class="text-[14px] text-slate-600 leading-relaxed line-clamp-3">
              ${p.summary_text}
            </p>
          </div>

          <div class="flex flex-wrap gap-2 mb-6">
            ${skillArray.slice(0, 10).map(skill => `
              <span class="bg-slate-50 text-slate-500 border border-slate-200 px-3 py-1 rounded-lg text-[10px] font-bold">
                ${skill}
              </span>
            `).join('')}
          </div>

          <div class="flex justify-end border-t border-slate-50 pt-6">
            <a href="/member/project-detail.php?id=${p.id}" class="bg-slate-900 text-white px-6 py-2.5 rounded-xl text-xs font-bold hover:bg-blue-600 transition-all shadow-lg shadow-slate-200">
              案件の詳細を見る
            </a>
          </div>
        </div>
        `;
      }).join('');
    }

    async function loadDashboardProjects() {
      try {
        const res = await fetch('/projects.json?v=' + Date.now());
        if (!res.ok) throw new Error('ファイルを読み込めませんでした');
        
        allProjects = await res.json();
        renderProjects(allProjects);
        
      } catch (e) {
        console.error('Fetch error:', e);
        document.getElementById('project-list-container').innerHTML = 
          `<p class="text-center py-20 text-red-400 font-bold">データの取得に失敗しました<br><span class="text-xs font-normal">${e.message}</span></p>`;
      }
    }

    async function checkAuth() {
      try {
        const res = await fetch('/api/check-session.php');
        const data = await res.json();
        if (!data.isLoggedIn) { window.location.href = '/?error=unauthorized'; return; }
        
        const headerName = document.getElementById('header-user-name');
        if (headerName) headerName.textContent = data.userName + ' 様';

        const statusLabel = document.getElementById('user-status-label');
        if (statusLabel) {
          let statusText = data.workStatus; 
          let statusColor = 'bg-slate-800'; 

          switch (data.workStatus) {
            case '就業中（良い案件があれば）':
              statusColor = 'bg-emerald-600'; 
              break;
            case '就業中（案件探し中）':
              statusColor = 'bg-amber-500';  
              break;
            case '離職中（即稼働可）':
              statusColor = 'bg-blue-600';   
              break;
            default:
              statusText = data.workStatus || 'ステータス未設定';
              statusColor = 'bg-slate-500';
          }
          
          statusLabel.textContent = `Status: ${statusText}`;
          statusLabel.className = `text-slate-50 text-[10px] mt-3 inline-block ${statusColor} px-3 py-1 rounded-full font-bold uppercase tracking-wider transition-colors duration-500`;
        }

        const content = document.getElementById('dashboard-content');
        if (content) { 
          content.classList.remove('invisible'); 
          content.classList.add('opacity-100'); 
        }
        
        updateNextScheduleDisplay();
        loadDashboardProjects();
      } catch (e) { window.location.href = '/'; }
    }
    
    checkAuth();
  </script>
</Layout>