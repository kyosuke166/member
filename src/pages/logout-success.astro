---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ログアウト完了 | SBTフリーランス" isLoggedIn={false}>
  {/* ポイント1: min-h-screen ではなく、ヘッダー/フッター分を引いた計算にする 
    ポイント2: ログイン画面などと統一感を出すために py-12 を追加
  */}
  <main class="min-h-[calc(100vh-200px)] flex items-center justify-center px-6 py-12">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-200 p-10 text-center animate-in fade-in zoom-in-95 duration-500">
      
      <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </div>

      <h1 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">ログアウトしました</h1>
      <p class="text-slate-500 text-sm font-medium leading-relaxed mb-8">
        SBTフリーランスをご利用いただきありがとうございました。<br class="hidden md:block" />またのご利用をお待ちしております。
      </p>

      <div class="flex flex-col gap-3">
        <a 
          href="/login" 
          class="bg-blue-600 text-white font-black py-4 px-6 rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/25 text-sm no-underline group flex items-center justify-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          ログイン画面へ戻る
        </a>
      </div>
    </div>
  </main>
</Layout>