---
import Layout from '../layouts/Layout.astro';
---

<Layout title="本登録完了 | SBTフリーランス" isLoggedIn={false}>
  <main class="min-h-[calc(100vh-200px)] flex items-center justify-center px-6 py-12">
    <div class="max-w-md w-full">
      
      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-200 p-8 md:p-12 text-center">
        <div class="w-20 h-20 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto mb-8 animate-bounce">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight mb-4">
          本登録が完了しました！
        </h1>
        
        <p class="text-slate-500 text-sm font-medium leading-relaxed mb-10">
          SBTフリーランスへの登録、誠にありがとうございます。<br />
          あなたにぴったりの案件探しをサポートいたします。
        </p>

        <div class="bg-slate-50 rounded-2xl p-6 text-left mb-10 border border-slate-100">
          <h2 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
            これからの流れ
          </h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm font-bold text-slate-600">
              <span class="text-blue-500 mt-0.5">01</span>
              <span>ログインして最新の案件情報をチェック</span>
            </li>
            <li class="flex items-start gap-3 text-sm font-bold text-slate-600">
              <span class="text-blue-500 mt-0.5">02</span>
              <span>マイページから詳細なスキル情報の追加</span>
            </li>
            <li class="flex items-start gap-3 text-sm font-bold text-slate-600">
              <span class="text-blue-500 mt-0.5">03</span>
              <span>担当エージェントからの面談連絡（順次）</span>
            </li>
          </ul>
        </div>

        <a 
          href="/" 
          class="w-full bg-blue-600 text-white font-black py-4 rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/25 flex items-center justify-center gap-2 group no-underline"
        >
          ログイン画面へ移動する
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

      </div>

    </div>
  </main>
</Layout>