---
import Layout from '../layouts/Layout.astro';
const title = "新規メンバー登録（仮登録） | SBTフリーランス";
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '6LdNxuUsAAAAADflUMi3Pre4JU1wM5KCubS24JN0';
const recaptchaAction = 'register_temp';
---

<Layout title={title} isLoggedIn={false}>
  <main class="min-h-[calc(100vh-200px)] flex items-center justify-center px-6 py-12">
    <div class="max-w-md w-full">
      <div class="text-center mb-10">
        <h1 class="text-3xl font-black text-slate-900 tracking-tight mb-2">
          まずは仮登録から
        </h1>
        <p class="text-slate-500 text-sm font-medium">
          ご入力いただいたメールアドレス宛に、<br />本登録用のURLをお送りします。
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-200 p-8 md:p-10">
        <form action="/api/register-temp.php" method="POST" class="space-y-6" id="registration-form">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
          <input type="hidden" name="g-recaptcha-response" />
          <input type="hidden" name="g-recaptcha-action" value={recaptchaAction} />
          <div>
            <label for="email" class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">
              メールアドレス
            </label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required 
              placeholder="example@sbt-inc.co.jp"
              class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-slate-900 placeholder:text-slate-300"
            />
          </div>

          <button 
            type="submit" 
            class="w-full bg-blue-600 text-white font-black py-4 rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/25 flex items-center justify-center gap-2 group"
          >
            確認メールを送信する
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </form>

        <div class="mt-8 p-4 rounded-xl bg-blue-50 border border-blue-100 flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <p class="text-xs font-bold text-blue-700 leading-relaxed">
            迷惑メール設定をされている方は「sbt-inc.co.jp」からのメールを受信できるように設定をお願いします。
          </p>
        </div>
      </div>

    </div>
  </main>
  {recaptchaSiteKey && <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} defer></script>}
</Layout>

<script is:inline define:vars={{ recaptchaSiteKey, recaptchaAction }}>
  function setupFormSubmit() {
    const form = document.getElementById('registration-form');
    if (!form) return;

    let isSubmitting = false;

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (isSubmitting) return;
      isSubmitting = true;

      if (!window.grecaptcha || !recaptchaSiteKey) {
        form.submit();
        return;
      }

      window.grecaptcha.ready(() => {
        window.grecaptcha.execute(recaptchaSiteKey, { action: recaptchaAction })
          .then((token) => {
            const tokenInput = form.querySelector('input[name="g-recaptcha-response"]');
            if (tokenInput) {
              tokenInput.value = token;
            }
            form.submit();
          })
          .catch(() => {
            isSubmitting = false;
            window.alert('reCAPTCHAの初期化に失敗しました。もう一度お試しください。');
          });
      });
    });
  }

  setupFormSubmit();
</script>